---
import Base from '../layouts/Base.astro';
import StuffOverlay from '../components/map/StuffOverlay.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

// process.cwd()-relative, not import.meta.url-relative: the latter resolves
// against wherever Vite/Astro's SSR bundler places this module during build,
// which is not reliably the source file's own directory, and silently threw
// so the page always rendered the "no data" state regardless of the file existing.
let nodeCount = 0;
try {
  const graph = JSON.parse(readFileSync(join(process.cwd(), 'public/graph/graph.json'), 'utf-8'));
  nodeCount = graph.nodes?.length ?? 0;
} catch {
  nodeCount = 0;
}
const isEmpty = nodeCount === 0;
---
<Base title="Graph" fullBleed>
  <div class="graph-page">
    <div class="graph-title">
      <h1>Graph</h1>
      <span class="hint">Kéo để xoay · Cuộn để zoom · Bấm để mở</span>
    </div>
    {isEmpty ? (
      <div class="graph-empty">Chưa có dữ liệu graph. Chạy <code>npm run graph</code> để tạo <code>public/graph/graph.json</code>.</div>
    ) : (
      <div id="graphContainer" class="graph-container" role="application" aria-label="Đồ thị 3D các stuff đã kết nối">
        <!-- ForceGraph3D wipes whatever element it mounts into (innerHTML = ''),
             so it gets its own empty mount point — everything else here is a
             sibling, never touched by that wipe. -->
        <div id="graphMount" class="graph-mount"></div>
        <div id="graphSkeleton" class="graph-skeleton" aria-hidden="true">
          <svg viewBox="0 0 100 100" class="graph-skeleton-sphere" aria-hidden="true">
            <circle cx="50" cy="50" r="42" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
            <ellipse cx="50" cy="50" rx="42" ry="14" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
            <ellipse cx="50" cy="50" rx="14" ry="42" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.5" />
          </svg>
        </div>
        <div id="graphFallback" class="graph-fallback" hidden></div>
        <nav id="graphA11yList" class="graph-a11y-list" aria-label="Danh sách đầy đủ các stuff trong graph, nhóm theo cụm"></nav>
      </div>
    )}
  </div>
  <StuffOverlay />
</Base>
<style is:global>
  .graph-page { display: flex; flex-direction: column; height: 100%; width: 100%; padding: 0.75rem 1rem; box-sizing: border-box; }
  .graph-title { flex: none; display: flex; align-items: baseline; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .graph-title h1 { margin: 0; font-size: 20px; }
  .graph-title .hint { color: var(--muted); font-size: 12px; }
  .graph-empty { flex: 1; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--muted); border: 1px solid var(--border); border-radius: 12px; padding: 2rem; }
  .graph-container { flex: 1 1 auto; min-height: 0; width: 100%; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); overflow: hidden; position: relative; }
  .graph-mount { position: absolute; inset: 0; z-index: 1; }
  .graph-container canvas { display: block; cursor: grab; }
  .graph-container canvas:active { cursor: grabbing; }
  .graph-container .clickable canvas,
  .graph-container canvas.clickable { cursor: pointer; }
  .graph-skeleton { position: absolute; inset: 0; z-index: 5; opacity: 1; transition: opacity 0.3s ease; pointer-events: none; display: flex; align-items: center; justify-content: center; background: var(--surface); color: var(--muted); }
  .graph-skeleton.is-hidden { opacity: 0; }
  .graph-skeleton-sphere { width: 140px; height: 140px; animation: graph-skeleton-spin 6s linear infinite; }
  @keyframes graph-skeleton-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .graph-skeleton-sphere { animation: none; }
  }
  .graph-fallback { position: absolute; inset: 0; overflow: auto; background: var(--surface); padding: 1rem 1.25rem; z-index: 3; }
  .graph-fallback h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 1rem 0 0.5rem; }
  .graph-fallback ul { list-style: none; margin: 0; padding: 0; }
  .graph-fallback li a { display: block; padding: 0.35rem 0; border-bottom: 1px solid var(--border-soft); }
  .graph-a11y-list:not([data-populated]) { display: none; }
  .graph-a11y-list { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .graph-a11y-list:focus-within { position: static; width: auto; height: auto; clip: auto; white-space: normal; background: var(--surface); padding: 1rem; overflow: auto; }
  .float-tooltip-kap { background: var(--ink) !important; color: #fff !important; border: 2px solid #fff !important; border-radius: 0 !important; font-family: var(--font-pixel) !important; font-size: 8px !important; padding: 6px 8px !important; box-shadow: none !important; }
  @media (max-width: 480px) {
    .graph-title .hint { display: none; }
  }
</style>
<script>
  const PALETTE = ['#c9563c', '#4c8577', '#7a6fb0', '#c9a13c', '#3c7fc9', '#a34c8f', '#5ba34c', '#8a8577'];

  function hasWebGL2() {
    try {
      const canvas = document.createElement('canvas');
      return !!(window.WebGL2RenderingContext && canvas.getContext('webgl2'));
    } catch {
      return false;
    }
  }

  function renderA11yList(nodes, container) {
    const byCommunity = new Map();
    nodes.forEach((n) => {
      const key = n.communityId ?? 0;
      if (!byCommunity.has(key)) byCommunity.set(key, []);
      byCommunity.get(key).push(n);
    });
    const frag = document.createDocumentFragment();
    [...byCommunity.entries()]
      .sort((a, b) => b[1].length - a[1].length)
      .forEach(([community, groupNodes], i) => {
        const h = document.createElement('h2');
        h.textContent = `Cụm ${i + 1}`;
        frag.appendChild(h);
        const ul = document.createElement('ul');
        groupNodes
          .slice()
          .sort((a, b) => (b.degree || 0) - (a.degree || 0))
          .forEach((n) => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = n.url || '#';
            a.textContent = n.title;
            li.appendChild(a);
            ul.appendChild(li);
          });
        frag.appendChild(ul);
      });
    container.appendChild(frag);
    container.setAttribute('data-populated', '');
  }

  function renderFallback(nodes, el) {
    el.hidden = false;
    renderA11yList(nodes, el);
    const h1 = document.createElement('p');
    h1.textContent = 'Trình duyệt của bạn không hỗ trợ WebGL2 — hiển thị danh sách thay cho graph 3D.';
    h1.style.cssText = 'color:var(--muted);font-size:12px;margin:0 0 0.5rem;';
    el.insertBefore(h1, el.firstChild);
  }

  async function main() {
    const container = document.getElementById('graphContainer');
    const mount = document.getElementById('graphMount');
    if (!container || !mount) return;
    const skeleton = document.getElementById('graphSkeleton');
    const fallbackEl = document.getElementById('graphFallback');
    const a11yList = document.getElementById('graphA11yList');

    const res = await fetch('/graph/graph.json');
    const { nodes, edges } = await res.json();

    if (a11yList) renderA11yList(nodes, a11yList);

    if (!hasWebGL2()) {
      if (skeleton) skeleton.classList.add('is-hidden');
      if (fallbackEl) renderFallback(nodes, fallbackEl);
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const [{ default: ForceGraph3D }, THREE, { default: SpriteText }] = await Promise.all([
      import('3d-force-graph'),
      import('three'),
      import('three-spritetext'),
    ]);

    const neighbors = new Map(nodes.map((n) => [n.id, new Set()]));
    const nodeLinks = new Map(nodes.map((n) => [n.id, new Set()]));
    edges.forEach((e) => {
      neighbors.get(e.source)?.add(e.target);
      neighbors.get(e.target)?.add(e.source);
      nodeLinks.get(e.source)?.add(e);
      nodeLinks.get(e.target)?.add(e);
    });

    const styles = getComputedStyle(document.documentElement);
    const bg = styles.getPropertyValue('--bg').trim() || '#303030';
    const { sphereRadius } = await import('../lib/graph-forces.mjs');
    const R = sphereRadius(nodes.length || 1);

    const highlightNodeIds = new Set();
    const highlightLinks = new Set();
    const NODE_RADIUS = 1;
    const NODE_OPACITY = 1;
    const DIM_OPACITY = 0.15;
    const LABEL_OPACITY = 0.6;
    const LABEL_DIM_OPACITY = 0.12;
    const LINK_COLOR = 'rgba(137, 135, 133, 0.25)';
    const LINK_COLOR_HOVER = 'rgba(240,163,67,1)';

    // Dimming mutates each mesh/label's existing material in place (via
    // nodeObjById) rather than reassigning nodeThreeObject — reassigning it
    // rebuilds every node mesh, which made the raycaster see a "new" object
    // under the cursor on every hover tick and starved onNodeClick of a
    // stable hoverObj.
    const nodeObjById = new Map();
    const applyDimming = () => {
      nodeObjById.forEach(({ mesh, label }, id) => {
        const dim = highlightNodeIds.size > 0 && !highlightNodeIds.has(id);
        mesh.material.opacity = dim ? DIM_OPACITY : NODE_OPACITY;
        label.material.opacity = dim ? LABEL_DIM_OPACITY : LABEL_OPACITY;
      });
    };

    const Graph = new ForceGraph3D(mount)
      .graphData({ nodes, links: edges })
      .nodeId('id')
      .backgroundColor(bg)
      .cooldownTicks(0)
      .warmupTicks(0)
      .numDimensions(3)
      .nodeLabel((n) => n.title)
      .nodeThreeObject((node) => {
        const color = PALETTE[(node.communityId ?? PALETTE.length) % PALETTE.length];
        const geometry = new THREE.SphereGeometry(NODE_RADIUS, 12, 12);
        const material = new THREE.MeshLambertMaterial({ color, transparent: true, opacity: NODE_OPACITY });
        const mesh = new THREE.Mesh(geometry, material);

        const label = new SpriteText(node.title);
        label.textHeight = 2.2;
        label.color = 'black';
        label.padding = 0.8;
        label.borderRadius = 0;
        label.material.opacity = LABEL_OPACITY;
        label.material.transparent = true;
        label.position.set(0, -(NODE_RADIUS + 4), 0);

        const group = new THREE.Group();
        group.add(mesh);
        group.add(label);
        nodeObjById.set(node.id, { mesh, label });
        return group;
      })
      .linkColor((l) => (highlightLinks.has(l) ? LINK_COLOR_HOVER : LINK_COLOR))
      .linkWidth((l) => (highlightLinks.has(l) ? 1.2 : 0.6))
      .linkOpacity(1)
      .onNodeHover((node) => {
        highlightNodeIds.clear();
        highlightLinks.clear();
        if (node) {
          highlightNodeIds.add(node.id);
          neighbors.get(node.id)?.forEach((id) => highlightNodeIds.add(id));
          nodeLinks.get(node.id)?.forEach((l) => highlightLinks.add(l));
        }
        applyDimming();
        Graph.linkColor(Graph.linkColor());
        Graph.linkWidth(Graph.linkWidth());
        container.style.cursor = node ? 'pointer' : 'grab';
      })
      .onNodeClick((node) => {
        const distance = 160;
        const ratio = 1 + distance / Math.hypot(node.x, node.y, node.z, 0.001);
        Graph.cameraPosition(
          { x: node.x * ratio, y: node.y * ratio, z: node.z * ratio },
          node,
          reducedMotion ? 0 : 800,
        );
        window.dispatchEvent(new CustomEvent('stuff:open', { detail: { slug: node.id } }));
      });

    // Default distance is proportional to R so the whole baked sphere is
    // framed on first paint — the library's own default (~1000) sits far
    // outside the fog, washing every node out to background color.
    Graph.cameraPosition({ x: 0, y: 0, z: R * 3.4 }, { x: 0, y: 0, z: 0 }, 0);
    Graph.scene().fog = new THREE.FogExp2(new THREE.Color(bg).getHex(), 0.19 / R);

    if (reducedMotion) {
      Graph.controls().autoRotate = false;
    }

    if (skeleton) setTimeout(() => skeleton.classList.add('is-hidden'), 200);

    // T15 — lifecycle: pause rendering when off-screen or tab hidden, cap DPR.
    Graph.renderer().setPixelRatio(Math.min(window.devicePixelRatio, 2));
    // Ignore the observer's first callback if it reports not-intersecting —
    // that can fire spuriously before layout settles and would pause the
    // render/raycast loop forever, since nothing else would un-pause it.
    let ioSettled = false;
    const io = new IntersectionObserver(([entry]) => {
      if (!ioSettled) {
        ioSettled = true;
        if (!entry.isIntersecting) return;
      }
      if (entry.isIntersecting) Graph.resumeAnimation();
      else Graph.pauseAnimation();
    });
    io.observe(container);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) Graph.pauseAnimation();
      else if (container.getBoundingClientRect().top < window.innerHeight) Graph.resumeAnimation();
    });

    let savedCamera = null;
    window.addEventListener('stuff:open', () => {
      savedCamera = Graph.cameraPosition();
    });
    window.addEventListener('stuff:close', () => {
      if (savedCamera) {
        Graph.cameraPosition(
          { x: savedCamera.x, y: savedCamera.y, z: savedCamera.z },
          savedCamera.lookAt,
          reducedMotion ? 0 : 500,
        );
      }
    });

    const resize = () => {
      Graph.width(container.clientWidth).height(container.clientHeight);
    };
    window.addEventListener('resize', resize);
    resize();
  }

  main();
</script>
