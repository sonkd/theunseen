---
import Base from '../layouts/Base.astro';
import StuffOverlay from '../components/map/StuffOverlay.astro';
import StuffThumb from '../components/StuffThumb.astro';
import FlameTorch from '../components/FlameTorch.astro';
import { getCollection } from 'astro:content';
import { iconFor, LEVEL_MAPS } from '../lib/icons';
import { MAPS as PALETTE } from '../lib/map/palette';
const stuff = (await getCollection('stuff', ({ data }) => data.published))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const levels = [1, 2, 3, 4, 5];
const categories = ['bias', 'mental-models', 'fallacy', 'memory', 'perception', 'theory', 'heuristic', 'social'];
const CATEGORY_LABELS = {
  'bias': 'Bias',
  'mental-models': 'Mental models',
  'fallacy': 'Fallacy',
  'memory': 'Memory',
  'perception': 'Perception',
  'theory': 'Theory',
  'heuristic': 'Heuristic',
  'social': 'Social',
};
const cardCount = stuff.length;
const PAGE_SIZE = 50;
---
<Base title="Library">
  <div class="filters">
    <div class="filter-header">
      <h1>Library</h1>
      <div class="result-count" id="resultCount">Showing {cardCount} cards</div>
    </div>

    <div class="filter-row">
      <div class="chips" id="categoryChips">
        {categories.map((cat) => (
          <button type="button" class="chip" data-filter-type="category" data-filter-value={cat} aria-pressed="false">
            {CATEGORY_LABELS[cat]}
          </button>
        ))}
      </div>
      <span class="filter-divider">|</span>
      <div class="chips" id="levelChips">
        {levels.map((l) => (
          <button type="button" class="chip" data-filter-type="level" data-filter-value={l.toString()} aria-pressed="false">
            {l} · {LEVEL_MAPS[l]}
          </button>
        ))}
      </div>
      <button type="button" class="clear-button" id="clearFilters">Clear</button>
    </div>

    <div class="chips" id="searchChips">
      <button type="button" class="chip chip-search hidden" id="searchChip" data-filter-type="search">
        <span id="searchChipLabel">Từ khoá: </span><span aria-hidden="true">✕</span>
      </button>
    </div>
  </div>

  <ul class="grid" id="cardGrid" data-page-size={PAGE_SIZE}>
    {stuff.map((s) => (
      <li class="card" data-slug={s.id} data-level={s.data.level.toString()} data-categories={s.data.categories.join(' ')} data-title={s.data.title} data-front={s.data.front}>
        <a href={`/stuff/${s.id}/`} data-slug={s.id}>
          <StuffThumb slug={s.id} title={s.data.title} image={s.data.image} categories={s.data.categories} level={s.data.level} icon={s.data.icon} />
          <span class="card-body">
            <span class="title">{s.data.title}</span>
            <span class="meta" style={`--level-color:${PALETTE[s.data.level - 1]?.icon ?? PALETTE[0].icon}`}>
              <span class="meta-dot" aria-hidden="true"></span>{LEVEL_MAPS[s.data.level]}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>

  <div class="empty-state hidden" id="emptyState">
    <FlameTorch size={200} />
    <p id="emptyStateCopy" class="code">Không tìm thấy kết quả phù hợp.</p>
    <button type="button" class="clear-button" id="clearFiltersEmpty">Bỏ lọc</button>
  </div>

  <nav class="pagination hidden" id="pagination" aria-label="Library pagination">
    <button type="button" id="pagePrev" class="page-nav">‹ Prev</button>
    <div class="page-numbers" id="pageNumbers">
      {Array.from({ length: Math.max(1, Math.ceil(cardCount / PAGE_SIZE)) }).map((_, i) => (
        <button type="button" data-page={i + 1} hidden>{i + 1}</button>
      ))}
    </div>
    <button type="button" id="pageNext" class="page-nav">Next ›</button>
  </nav>

  <StuffOverlay />
</Base>
<style>
  .filters {
    border: 1px solid var(--border); background: var(--surface);
    padding: .75rem 1rem; border-radius: 12px; margin-bottom: 1.5rem;
  }
  .filter-header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; align-items: baseline; }
  .filters h1 { font-size: 24px; margin: 0; }
  .result-count { color: var(--muted); font-size: 12px; }
  .filter-row {
    display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin-top: .5rem;
    padding-bottom: .2rem;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .filter-divider { color: var(--border); flex-shrink: 0; }
  .chip {
    appearance: none; border: 1px solid var(--border); background: #fff; color: var(--text);
    border-radius: 999px; padding: .3rem .5rem; cursor: pointer; white-space: nowrap;
    font-size: 9px; font-family: var(--font-pixel, inherit);
    transition: transform .15s ease, background .15s ease, border-color .15s ease;
  }
  .chip:hover { transform: translateY(-1px); border-color: var(--flame); }
  .chip.active { background: rgba(240,163,67,.15); border-color: var(--flame); color: var(--flame); }
  .chip.hidden { display: none; }
  .chip-search {
    background: rgba(240,163,67,.15); border-color: var(--flame); color: var(--accent);
    display: flex; align-items: center; gap: .4rem;
  }
  #searchChips:has(.chip-search.hidden) { display: none; }
  .clear-button {
    appearance: none; border: 1px solid var(--border); background: transparent; color: var(--text);
    border-radius: 999px; padding: .35rem .6rem; cursor: pointer; white-space: nowrap; font-size: 12px; flex-shrink: 0;
  }
  .clear-button:hover { border-color: var(--flame); color: var(--flame); }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px; margin: 0; }
  .grid.hidden { display: none; }
  .grid a {
    text-decoration: none; color: var(--text); display: flex; gap: 16px;
    min-height: 112px; padding: 16px; border: 1px solid var(--border); border-radius: 12px; align-items: start;
    transition: transform .15s ease-out, background .15s ease-out, border-color .15s ease-out;
  }
  .grid a:hover { border-color: var(--flame); background: rgba(240,163,67,.06); transform: translateY(-1px); }
  .card { transition: opacity .2s ease, transform .2s ease; }
  .card[hidden] { display: none !important; }
  .card-body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .title {
    font-size: 16px; font-weight: 600; line-height: 1.3;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  }
  .meta {
    display: inline-flex; align-items: center; gap: .35rem;
    color: var(--muted); font-size: 10px; letter-spacing: .08em; font-family: var(--font-pixel, inherit);
    border: 1px solid var(--border-soft); border-radius: 999px; padding: .2rem .55rem; white-space: nowrap;
    align-self: start;
  }
  .meta-dot {
    width: 6px; height: 6px; border-radius: 50%; flex: none;
    background: var(--level-color, var(--muted));
  }
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #efe7d8;
    text-align: center; padding: 3rem 1rem; color: var(--muted);
    border: 1px solid var(--border); border-radius: 12px; margin-top: 1rem;
    background:
      radial-gradient(ellipse 70% 60% at 50% 42%, #241f1a 0%, #16130f 55%, #0d0b09 100%);
  }
  .empty-state.hidden { display: none; }
  .empty-state p { margin: 0 0 1rem; font-size: 16px; }
  .pagination { display: flex; align-items: center; justify-content: center; gap: .75rem; margin-top: 2rem; }
  .pagination.hidden { display: none; }
  .page-nav {
    appearance: none; border: 1px solid var(--border); background: #fff; color: var(--text);
    border-radius: 999px; padding: .55rem 1rem; cursor: pointer; font-size: 14px;
  }
  .page-nav:hover:not(:disabled) { border-color: var(--flame); color: var(--flame); }
  .page-nav:disabled { opacity: .4; cursor: default; }
  .page-numbers { display: flex; gap: .35rem; }
</style>
<style is:global>
  .page-numbers button {
    appearance: none; border: 1px solid var(--border); background: #fff; color: var(--text);
    border-radius: 999px; width: 2.2rem; height: 2.2rem; cursor: pointer; font-size: 14px;
  }
  .page-numbers button.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .page-numbers button:hover:not(.active) { border-color: var(--flame); color: var(--flame); }
</style>
<script>
  const categoryButtons = Array.from(document.querySelectorAll('[data-filter-type="category"]'));
  const levelButtons = Array.from(document.querySelectorAll('[data-filter-type="level"]'));
  const clearButton = document.getElementById('clearFilters');
  const resultCount = document.getElementById('resultCount');
  const cardGrid = document.getElementById('cardGrid');
  const cards = Array.from(document.querySelectorAll('.card'));
  const cardLinks = Array.from(document.querySelectorAll('.card a[data-slug]'));
  const pagination = document.getElementById('pagination');
  const pagePrev = document.getElementById('pagePrev');
  const pageNext = document.getElementById('pageNext');
  const pageNumbers = document.getElementById('pageNumbers');
  const pageNumberButtons = Array.from(pageNumbers.querySelectorAll('button'));
  const emptyState = document.getElementById('emptyState');
  const emptyStateCopy = document.getElementById('emptyStateCopy');
  const clearFiltersEmpty = document.getElementById('clearFiltersEmpty');
  const PAGE_SIZE = Number(cardGrid.dataset.pageSize) || 50;
  const CATEGORY_LABELS = {};
  categoryButtons.forEach((button) => { CATEGORY_LABELS[button.dataset.filterValue] = button.textContent.trim(); });
  const LEVEL_MAPS = ['', 'Imagining', 'Belief', 'Thinking', 'Intelligence', 'Knowledge'];

  const searchChip = document.getElementById('searchChip');
  const searchChipLabel = document.getElementById('searchChipLabel');
  const searchInputs = Array.from(document.querySelectorAll('input[name="q"]'));

  const parseValues = (value) => value ? value.split(',').map((item) => item.trim()).filter(Boolean) : [];

  const getState = () => {
    const params = new URLSearchParams(window.location.search);
    const page = Math.max(1, parseInt(params.get('page'), 10) || 1);
    return {
      categories: parseValues(params.get('cat')),
      levels: parseValues(params.get('level')),
      q: params.get('q') || '',
      page,
    };
  };

  const setChipState = (buttons, activeValues) => {
    buttons.forEach((button) => {
      const value = button.dataset.filterValue;
      const active = activeValues.includes(value);
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
  };

  // Chỉ set/xoá các tham số mà trang này quản lý (cat/level/page/q) — mọi tham số
  // khác đã có trên URL được giữ nguyên, không dựng lại query từ đầu.
  const updateUrl = (state) => {
    const params = new URLSearchParams(window.location.search);
    const setOrDelete = (key, value) => {
      if (value) params.set(key, value);
      else params.delete(key);
    };
    setOrDelete('cat', state.categories.length ? state.categories.join(',') : '');
    setOrDelete('level', state.levels.length ? state.levels.join(',') : '');
    setOrDelete('q', state.q || '');
    setOrDelete('page', state.page > 1 ? String(state.page) : '');
    const query = params.toString();
    const nextUrl = query ? `${window.location.pathname}?${query}` : window.location.pathname;
    window.history.replaceState({}, '', nextUrl);
  };

  const renderPageNumbers = (page, totalPages) => {
    pageNumberButtons.forEach((button) => {
      const n = Number(button.dataset.page);
      button.hidden = n > totalPages;
      button.classList.toggle('active', n === page);
    });
  };

  const applyFilters = (state) => {
    setChipState(categoryButtons, state.categories);
    setChipState(levelButtons, state.levels);

    const q = (state.q || '').trim();
    const qLower = q.toLowerCase();
    searchChip.classList.toggle('hidden', !q);
    searchChipLabel.textContent = `Từ khoá: ${q} `;
    searchInputs.forEach((input) => { input.value = q; });

    const categorySet = new Set(state.categories);
    const levelSet = new Set(state.levels);

    const matches = cards.filter((card) => {
      const cardCategories = card.dataset.categories.split(' ').filter(Boolean);
      const cardLevel = card.dataset.level;
      const categoryMatch = categorySet.size === 0 || cardCategories.some((cat) => categorySet.has(cat));
      const levelMatch = levelSet.size === 0 || levelSet.has(cardLevel);
      const haystack = `${card.dataset.title} ${card.dataset.front}`.toLowerCase();
      const searchMatch = !qLower || haystack.includes(qLower);
      return categoryMatch && levelMatch && searchMatch;
    });

    const totalPages = Math.max(1, Math.ceil(matches.length / PAGE_SIZE));
    const page = Math.min(Math.max(1, state.page), totalPages);
    const pageStart = (page - 1) * PAGE_SIZE;
    const pageEnd = pageStart + PAGE_SIZE;
    const matchSet = new Set(matches);

    let visibleCount = 0;
    cards.forEach((card) => {
      const matchIndex = matches.indexOf(card);
      const inPage = matchSet.has(card) && matchIndex >= pageStart && matchIndex < pageEnd;
      card.hidden = !inPage;
      if (inPage) visibleCount += 1;
    });

    const searchSuffix = q ? ` matching "${q}"` : '';
    resultCount.textContent = `Showing ${visibleCount} / ${matches.length} cards${searchSuffix} (page ${page} of ${totalPages})`;

    const isEmpty = matches.length === 0;
    cardGrid.classList.toggle('hidden', isEmpty);
    emptyState.classList.toggle('hidden', !isEmpty);
    if (isEmpty) {
      const activeLabels = [
        ...(q ? [`từ khoá "${q}"`] : []),
        ...state.categories.map((c) => CATEGORY_LABELS[c] ?? c),
        ...state.levels.map((l) => `${l} · ${LEVEL_MAPS[Number(l)]}`),
      ];
      emptyStateCopy.textContent = activeLabels.length
        ? `Không tìm thấy kết quả phù hợp: ${activeLabels.join(', ')}.`
        : 'Không có flame nào.';
    }

    pagination.classList.toggle('hidden', totalPages <= 1);
    pagePrev.disabled = page <= 1;
    pageNext.disabled = page >= totalPages;
    renderPageNumbers(page, totalPages);

    updateUrl({ ...state, page });
  };

  const goToPage = (page) => {
    applyFilters({ ...getState(), page });
    cardGrid.scrollIntoView({ block: 'start' });
  };

  const toggleValue = (list, value) => {
    const index = list.indexOf(value);
    if (index === -1) list.push(value);
    else list.splice(index, 1);
  };

  const handleChipClick = (event) => {
    const button = event.currentTarget;
    const type = button.dataset.filterType;
    const value = button.dataset.filterValue;
    const state = getState();
    if (type === 'category') toggleValue(state.categories, value);
    if (type === 'level') toggleValue(state.levels, value);
    applyFilters({ ...state, page: 1 });
  };

  categoryButtons.forEach((button) => button.addEventListener('click', handleChipClick));
  levelButtons.forEach((button) => button.addEventListener('click', handleChipClick));
  searchChip.addEventListener('click', () => applyFilters({ ...getState(), q: '', page: 1 }));

  // Ô search ở header (Base.astro) submit khi đang ở /library → lọc tại chỗ,
  // không reload trang. Base.astro đã cập nhật URL trước khi bắn sự kiện này.
  window.addEventListener('unseen:search', (event) => {
    const q = (event.detail && event.detail.q) || '';
    applyFilters({ ...getState(), q, page: 1 });
  });
  const clearAll = () => applyFilters({ categories: [], levels: [], q: '', page: 1 });
  clearButton.addEventListener('click', clearAll);
  clearFiltersEmpty.addEventListener('click', clearAll);
  pageNumberButtons.forEach((button) => {
    button.addEventListener('click', () => goToPage(Number(button.dataset.page)));
  });
  pagePrev.addEventListener('click', () => goToPage(getState().page - 1));
  pageNext.addEventListener('click', () => goToPage(getState().page + 1));

  cardLinks.forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      window.dispatchEvent(new CustomEvent('stuff:open', { detail: { slug: link.dataset.slug } }));
    });
  });

  applyFilters(getState());
</script>
