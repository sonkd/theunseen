---
import StuffThumb from '../StuffThumb.astro';
---
<div id="stuff-overlay" class="stuff-overlay hidden" aria-hidden="true">
  <div class="overlay-backdrop" data-close="true"></div>
  <section
    class="overlay-card"
    id="overlay-card"
    role="button"
    tabindex="0"
    aria-label="Flip card"
  >
    <div class="flip-hint hidden" id="flip-hint">Click to flip</div>
    <div class="card-inner" id="card-inner">
      <div class="card-face card-front" id="card-front">
        <div class="card-band" id="card-band">
          <span class="band-cat" id="stuff-cat"></span>
          <span class="band-map" id="stuff-map-front"></span>
        </div>
        <div class="card-scroll">
          <div class="card-illustration" id="card-illustration">
            <StuffThumb slug="" title="" id="front" />
          </div>
          <h2 class="card-title" id="stuff-title-front"></h2>
          <p class="card-front-q" id="stuff-front"></p>
          <div class="card-definition">
            <span class="field-label">DEFINITION</span>
            <p id="stuff-back"></p>
          </div>
          <div class="card-loop-in" id="card-loop-in">
            <span class="field-label">LOOP IN</span>
            <div class="chips" id="stuff-links"></div>
          </div>
        </div>
        <div class="card-footer">
          <span class="footer-map" id="stuff-map-footer-front"></span>
          <span class="footer-spacer"></span>
          <button id="overlay-close" type="button">CLOSE</button>
          <button id="overlay-share" type="button">SHARE</button>
        </div>
      </div>
      <div class="card-face card-back" id="card-back">
        <h2 class="card-title back-title" id="stuff-title-back"></h2>
        <div class="card-scroll">
          <div class="card-body" id="stuff-body"></div>
          <div class="card-strategy hidden" id="card-strategy">
            <span class="field-label">STRATEGY</span>
            <p id="stuff-strategy"></p>
          </div>
          <div class="card-refs" id="card-refs">
            <span class="field-label">READ MORE</span>
            <ul id="stuff-refs"></ul>
          </div>
        </div>
        <div class="card-footer">
          <span class="footer-site">THE UNSEEN</span>
          <span class="footer-map" id="stuff-map-footer-back"></span>
          <span class="footer-spacer"></span>
          <button id="overlay-close-back" type="button">CLOSE</button>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { markLit } from '../../lib/progress'
  import { MAPS as PALETTE } from '../../lib/map/palette'

  const overlay = document.getElementById('stuff-overlay')
  const refsNode = document.getElementById('stuff-refs')
  const linksNode = document.getElementById('stuff-links')
  const overlayCard = document.getElementById('overlay-card')
  const cardInner = document.getElementById('card-inner')
  const flipHint = document.getElementById('flip-hint')
  const shareButton = document.getElementById('overlay-share')
  const closeButton = document.getElementById('overlay-close')
  const closeButtonBack = document.getElementById('overlay-close-back')
  const strategyBlock = document.getElementById('card-strategy')

  const FLIP_HINT_KEY = 'unseen:flip-hint-seen'
  let hintHoverActive = false
  let hintTimeout = null

  let mapItems = []
  let currentSlug = ''
  let currentLevel = null

  async function fetchMapData() {
    if (mapItems.length) return mapItems
    try {
      const response = await fetch('/map-data.json')
      const data = await response.json()
      const maps = Array.isArray(data.maps) ? data.maps : []
      mapItems = maps.flatMap(map =>
        map.stuff.map(item => ({ ...item, level: map.level, mapName: map.name, mapGreek: map.greek, mapVn: map.vn }))
      )
    } catch (error) {
      mapItems = []
    }
    return mapItems
  }

  function setText(id, value) {
    const node = document.getElementById(id)
    if (node) node.textContent = value
  }

  // Chọn màu chữ tương phản với màu nền băng đầu thẻ (pal.icon dao động từ
  // pastel sáng tới nâu đậm tuỳ map) — tính luminance thay vì hard-code.
  function contrastTextColor(hex) {
    const value = (hex || '').replace('#', '')
    if (value.length !== 6) return '#111114'
    const r = parseInt(value.slice(0, 2), 16)
    const g = parseInt(value.slice(2, 4), 16)
    const b = parseInt(value.slice(4, 6), 16)
    const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255
    return luminance > 0.6 ? '#111114' : '#fdfbf5'
  }

  function updatePanel(item) {
    currentSlug = item.slug
    currentLevel = item.level
    const pal = PALETTE[(item.level || 1) - 1] || PALETTE[0]
    const icon = item.icon || '★'

    overlayCard.style.setProperty('--card-map-color', pal.icon)
    overlayCard.style.setProperty('--card-map-text', contrastTextColor(pal.icon))
    overlayCard.style.setProperty('--card-map-glow', pal.iconGlow)

    setText('stuff-title-front', item.title || item.slug)
    setText('stuff-title-back', `Overview: ${item.title || item.slug}`)
    setText('stuff-front', item.front || '')
    setText('stuff-back', item.back || '')

    const wrap = document.getElementById('front-thumb')
    if (wrap) wrap.dataset.slug = item.slug || ''
    const img = document.getElementById('front-thumb-img')
    const fallback = document.getElementById('front-thumb-fallback')
    if (item.image) {
      if (img) {
        img.src = item.image
        img.alt = item.title || item.slug || ''
        img.style.display = ''
      }
      if (fallback) fallback.style.display = 'none'
    } else {
      if (img) img.style.display = 'none'
      if (fallback) {
        fallback.textContent = icon
        fallback.style.color = pal.icon
        fallback.style.display = ''
      }
    }

    const categories = item.categories || []
    setText('stuff-cat', (categories[0] || '').toUpperCase())

    const mapLabel = `Map ${item.level} · ${item.mapVn || item.mapName || ''}`
    setText('stuff-map-front', mapLabel)
    const footerMap = `Map ${item.level}`
    setText('stuff-map-footer-front', footerMap)
    setText('stuff-map-footer-back', footerMap)

    document.getElementById('stuff-body').innerHTML = item.body_html || '<p>No content available.</p>'

    if (item.strategy) {
      setText('stuff-strategy', item.strategy)
      strategyBlock.classList.remove('hidden')
    } else {
      strategyBlock.classList.add('hidden')
    }

    refsNode.innerHTML = ''
    const refs = item.refs || []
    if (refs.length === 0) {
      refsNode.innerHTML = '<li>No refs</li>'
    } else {
      refs.forEach(ref => {
        const li = document.createElement('li')
        const a = document.createElement('a')
        a.href = typeof ref === 'string' ? ref : ref.url || '#'
        a.textContent = typeof ref === 'string' ? ref : ref.title || ref.url
        a.target = '_blank'
        a.rel = 'noopener nofollow'
        li.appendChild(a)
        refsNode.appendChild(li)
      })
    }

    linksNode.innerHTML = '';
    const links = item.links || [];
    links.forEach(link => {
      const slug = typeof link === 'string' ? link : (link.slug || '');
      const label = typeof link === 'string' ? link : (link.title || slug);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'chip';
      button.textContent = label;
      button.addEventListener('click', () => openStuff(slug));
      linksNode.appendChild(button);
    });
  }

  async function openStuff(slug) {
    const response = await fetch(`/stuff-data/${slug}.json`)
    if (!response.ok) return
    const data = await response.json()
    const mapData = await fetchMapData()
    const item = mapData.find(entry => entry.slug === slug) || {}
    updatePanel({ ...item, ...data })
    cardInner.classList.remove('is-flipped')
    overlay.classList.remove('hidden')
    overlay.setAttribute('aria-hidden', 'false')
    overlayCard?.focus()
    markLit(slug)
    maybeShowFirstTimeHint()
  }

  function closeOverlay() {
    overlay.classList.add('hidden')
    overlay.setAttribute('aria-hidden', 'true')
    window.dispatchEvent(new CustomEvent('stuff:close'))
  }

  function flipCard() {
    cardInner.classList.toggle('is-flipped')
  }

  function showHint() {
    flipHint.classList.remove('hidden')
  }

  function hideHint() {
    if (!hintHoverActive) flipHint.classList.add('hidden')
  }

  function maybeShowFirstTimeHint() {
    let seen = false
    try {
      seen = sessionStorage.getItem(FLIP_HINT_KEY) === '1'
    } catch (error) {
      seen = false
    }
    if (seen) return
    try {
      sessionStorage.setItem(FLIP_HINT_KEY, '1')
    } catch (error) {
      // ignore — sessionStorage unavailable (private mode, etc.)
    }
    showHint()
    clearTimeout(hintTimeout)
    hintTimeout = setTimeout(hideHint, 2600)
  }

  async function shareCurrent() {
    const url = `${window.location.origin}/stuff/${currentSlug}`
    try {
      await navigator.clipboard.writeText(url)
    } catch (error) {
      console.warn('Unable to copy share URL', error)
    }
  }

  function moveRelative(direction) {
    const sameMap = mapItems.filter(item => item.level === currentLevel)
    const index = sameMap.findIndex(item => item.slug === currentSlug)
    if (index === -1) return
    const nextIndex = index + direction
    if (nextIndex < 0 || nextIndex >= sameMap.length) return
    openStuff(sameMap[nextIndex].slug)
  }

  window.addEventListener('stuff:open', event => {
    const slug = event?.detail?.slug
    if (!slug || slug === currentSlug) return
    openStuff(slug)
  })

  window.addEventListener('stuff:nav', event => {
    if (overlay.classList.contains('hidden')) return
    const direction = event?.detail?.direction
    if (direction) moveRelative(direction)
  })

  window.addEventListener('keydown', event => {
    if (overlay.classList.contains('hidden')) return
    if (event.key === 'Escape') closeOverlay()
  })

  overlay.addEventListener('click', event => {
    if (event.target.dataset.close === 'true') closeOverlay()
  })

  closeButton.addEventListener('click', closeOverlay)
  closeButtonBack.addEventListener('click', closeOverlay)
  shareButton.addEventListener('click', shareCurrent)

  overlayCard.addEventListener('click', event => {
    if (event.target.closest('button') || event.target.closest('a')) return
    flipCard()
  })
  overlayCard.addEventListener('keydown', event => {
    if (event.target.closest('button') || event.target.closest('a')) return
    if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
      event.preventDefault()
      flipCard()
    }
  })
  overlayCard.addEventListener('mouseenter', () => {
    hintHoverActive = true
    showHint()
  })
  overlayCard.addEventListener('mouseleave', () => {
    hintHoverActive = false
    hideHint()
  })
</script>

<style>
  .stuff-overlay.hidden { display: none; }
  .stuff-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 16px;
  }
  .overlay-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(8, 6, 2, .82);
  }

  /* Thẻ đơn khối 9:16, ~420px rộng, cao tối đa 82vh — không còn 3 cột rời. */
  .overlay-card {
    position: relative;
    width: min(420px, 92vw);
    aspect-ratio: 9 / 16;
    max-height: 82vh;
    perspective: 1800px;
    flex: none;
    cursor: pointer;
    --card-map-color: var(--flame);
    --card-map-text: var(--ink);
    --card-map-glow: rgba(240, 163, 67, .6);
  }
  .overlay-card:focus-visible {
    outline: 3px solid var(--flame);
    outline-offset: 4px;
  }
  .flip-hint {
    position: absolute;
    left: 50%;
    top: -18px;
    transform: translate(-50%, -100%);
    z-index: 8;
    pointer-events: none;
    background: var(--ink);
    border: 2px solid #fff;
    color: #fff;
    font-family: var(--font-pixel);
    font-size: 8px;
    padding: 6px 8px;
    white-space: nowrap;
    transition: opacity .15s ease;
  }
  .flip-hint.hidden { display: none; }
  .card-inner {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transition: transform .6s ease;
    border-radius: 24px;
    box-shadow: 0 30px 70px rgba(10, 8, 4, .45), 0 6px 18px rgba(10, 8, 4, .25);
  }
  .card-inner.is-flipped { transform: rotateY(180deg); }
  .card-face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    border-radius: 24px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .card-front {
    background: var(--bg);
    border: 2px solid var(--ink);
    color: var(--text);
  }
  .card-back {
    transform: rotateY(180deg);
    background: var(--dark-bg-2);
    color: #eee;
    border: 2px solid var(--ink);
    padding: 0;
    gap: 12px;
  }

  .card-band {
    flex: none;
    background: var(--card-map-color);
    color: var(--card-map-text);
    padding: 10px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
    font-family: var(--font-pixel);
    font-size: 8px;
    letter-spacing: .08em;
  }
  .band-cat { font-weight: 700; }
  .band-map { opacity: .85; }

  .card-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card-back > .card-scroll { padding: 0; }

  .card-illustration {
    align-self: center;
    width: 128px;
    height: 128px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 16px;
    background: color-mix(in srgb, var(--card-map-color) 16%, #fff);
    border: 1px solid var(--border);
  }
  .card-illustration :global(.stuff-thumb),
  .card-illustration :global(.stuff-thumb-img),
  .card-illustration :global(.stuff-thumb-fallback) {
    width: 128px;
    height: 128px;
  }
  .card-illustration :global(.stuff-thumb-fallback) { font-size: 52px; background: transparent; border: none; }

  .card-title { margin: 0; font-size: 28px; font-weight: 700; line-height: 1.15; text-align: left; }
  .back-title {
    flex: none;
    font-size: 20px;
    padding: 20px 24px 0;
    color: #fff;
  }
  .card-front-q { margin: 0; font-size: 18px; font-weight: 600; line-height: 1.4; }

  .field-label {
    display: block;
    font-family: var(--font-pixel);
    font-size: 9px;
    letter-spacing: .08em;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .card-back .field-label { color: var(--muted-2); }

  .card-definition p { margin: 0; font-size: 13px; line-height: 1.5; }

  .card-loop-in .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  /* <button> tạo runtime (document.createElement) → không có data-astro-cid-*,
     CSS scoped thường không match — dùng :global() giới hạn trong khối tĩnh này.
     Style đồng bộ .chip ở library.astro (nút bo tròn, viền mảnh, hover nổi nhẹ). */
  .card-loop-in :global(.chip) {
    appearance: none;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text);
    border-radius: 999px;
    padding: .3rem .5rem;
    cursor: pointer;
    white-space: nowrap;
    font-size: 9px;
    font-family: var(--font-pixel, inherit);
    transition: transform .15s ease, background .15s ease, border-color .15s ease;
  }
  .card-loop-in :global(.chip):hover { transform: translateY(-1px); border-color: var(--flame); }

  .card-body { font-size: 14px; line-height: 1.6; padding: 16px 24px 0; }
  .card-body :global(p) { margin: 0 0 .75em; }
  .card-body :global(h1),
  .card-body :global(h2),
  .card-body :global(h3) { font-size: 15px; margin: 0 0 .5em; }
  .card-body :global(ul) { margin: 0 0 .75em; padding-left: 1.2em; }

  .card-strategy {
    margin: 16px 24px 0;
    padding: 14px 16px;
    background: rgba(240, 163, 67, .14);
    border: 1.5px solid var(--flame);
    border-radius: 10px;
  }
  .card-strategy.hidden { display: none; }
  .card-strategy p { margin: 0; font-size: 13px; line-height: 1.5; color: #fff; }

  .card-refs { padding: 16px 24px 20px; }
  .card-refs ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .card-refs :global(a) {
    font-size: 11px;
    color: var(--muted-2);
    word-break: break-all;
  }
  .card-refs :global(a):hover { color: #fff; }

  .card-footer {
    flex: none;
    border-top: 1.5px solid var(--border);
    padding: 14px 24px;
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .card-back .card-footer { border-top-color: rgba(255,255,255,.3); padding: 14px 24px; }
  .footer-map { font-size: 10px; color: var(--muted); font-family: var(--font-pixel); }
  .footer-site { font-size: 10px; color: var(--muted-2); font-family: var(--font-pixel); letter-spacing: .06em; }
  .card-back .footer-map { color: var(--muted-2); }
  .footer-spacer { flex: 1; }
  .card-footer button {
    border-radius: 7px;
    padding: 9px 16px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .06em;
    cursor: pointer;
    flex: none;
  }
  #overlay-close { background: var(--ink); color: #fff; border: 2px solid var(--ink); }
  #overlay-share { background: #fff; color: var(--ink); border: 2px solid var(--ink); }
  #overlay-share:hover { background: var(--surface); }
  #overlay-close-back { background: none; color: #fff; border: 2px solid #fff; }
  #overlay-close-back:hover { background: rgba(255,255,255,.12); }

  /* Tôn trọng prefers-reduced-motion: bỏ lật 3D, chuyển sang fade. */
  @media (prefers-reduced-motion: reduce) {
    .card-inner { transition: none; transform: none !important; }
    .card-face {
      transition: opacity .25s ease;
      backface-visibility: visible;
    }
    .card-back { transform: none; opacity: 0; pointer-events: none; }
    .card-front { opacity: 1; }
    .card-inner.is-flipped .card-front { opacity: 0; pointer-events: none; }
    .card-inner.is-flipped .card-back { opacity: 1; pointer-events: auto; }
  }

  @media (max-width: 640px) {
    .stuff-overlay { padding: 0; }
    .overlay-card {
      width: cal(100vw - 2rem);
      max-height: 90vh;
      height: 90vh;
      aspect-ratio: auto;
    }
    .card-inner, .card-face { border-radius: 0; }
  }
</style>
