---
// Ngọn nến trong hang — hình minh hoạ thương hiệu (Plato's cave).
// Line-art xoắn + quầng sáng, dựng bằng SVG thuần, animation bằng CSS.
// Dùng ở /404 và bất cứ đâu cần "đốm lửa trong bóng tối".
//
// Props:
//   size   — chiều rộng hiển thị (px). Mặc định 320.
//   glow   — bật/tắt quầng sáng + vignette nền. Tắt khi đặt trên nền sáng.
interface Props { size?: number; glow?: boolean; class?: string }
const { size = 320, glow = true, class: klass = '' } = Astro.props;
---

<div class={`flame-torch ${klass}`} style={`--torch-size:${size}px`} aria-hidden="true">
  <svg viewBox="0 0 400 500" width="100%" height="100%" role="img">
    <defs>
      <radialGradient id="ft-halo" cx="50%" cy="52%" r="50%">
        <stop offset="0%"   stop-color="#fff5e2" stop-opacity=".22" />
        <stop offset="45%"  stop-color="#f0a343" stop-opacity=".10" />
        <stop offset="100%" stop-color="#f0a343" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="ft-core" cx="50%" cy="70%" r="55%">
        <stop offset="0%"   stop-color="#fff8ec" stop-opacity=".95" />
        <stop offset="60%"  stop-color="#f0a343" stop-opacity=".35" />
        <stop offset="100%" stop-color="#f0a343" stop-opacity="0" />
      </radialGradient>
    </defs>

    {glow && <ellipse class="ft-halo" cx="200" cy="270" rx="190" ry="215" fill="url(#ft-halo)" />}

    <!-- Vách hang hai bên: chỉ gợi hình, để bóng tối tự nuốt phần còn lại -->
    <g class="ft-rock" stroke="currentColor" stroke-width="1.1" fill="none" opacity=".30"
       stroke-linecap="round" stroke-linejoin="round">
      <!-- vách trái: khối đá dựng đứng, mặt cắt lởm chởm + vân dọc -->
      <path d="M8 436 L14 330 L26 352 L34 268 L48 300 L58 232 L70 286 L82 262 L92 330 L104 306 L112 436 Z" />
      <path d="M26 372 L32 436 M48 322 L54 436 M70 302 L76 436 M92 348 L96 436" opacity=".55" />
      <path d="M34 292 L46 316 M58 254 L68 276 M82 282 L90 306" opacity=".4" />
      <!-- vách phải -->
      <path d="M392 440 L386 322 L374 346 L366 258 L352 292 L342 224 L330 280 L318 254 L308 326 L296 300 L288 440 Z" />
      <path d="M374 366 L368 440 M352 314 L346 440 M330 296 L324 440 M308 344 L304 440" opacity=".55" />
      <path d="M366 282 L354 308 M342 246 L332 270 M318 274 L310 300" opacity=".4" />
    </g>

    <!-- Nền hang + mặt đất lốm đốm -->
    <g class="ft-ground" stroke="currentColor" fill="none" opacity=".38" stroke-linecap="round">
      <path d="M40 434 Q200 418 360 434" stroke-width="1.3" />
      <g stroke-width="1.6" opacity=".7">
        <path d="M120 446 h7 M150 452 h5 M262 446 h7 M296 452 h6 M186 458 h4 M228 456 h5" />
      </g>
      <g fill="currentColor" stroke="none" opacity=".55">
        <circle cx="104" cy="440" r="1.5" /><circle cx="168" cy="448" r="1.3" />
        <circle cx="244" cy="442" r="1.4" /><circle cx="312" cy="448" r="1.3" />
      </g>
    </g>

    <!-- Xoáy khói trên cao -->
    <g class="ft-swirl" stroke="currentColor" stroke-width="1.1" fill="none" opacity=".30"
       stroke-linecap="round">
      <path d="M118 96 c22-16 46-2 40 18 c-5 17-30 18-34 4 c-3-11 10-18 18-12 c6 4 5 12-1 14" />
      <path d="M242 88 c24-18 50-3 44 19 c-6 18-32 19-37 4 c-3-12 11-19 19-13 c7 5 6 13-1 15" />
      <path d="M92 138 q34-14 66-4" opacity=".5" />
      <path d="M244 132 q36-16 70-2" opacity=".5" />
    </g>

    <!-- Sao 4 cánh + bụi sáng -->
    <g class="ft-stars" stroke="currentColor" stroke-width="1.2" fill="none" opacity=".7"
       stroke-linecap="round">
      <g class="ft-twinkle ft-t1"><path d="M136 152 v22 M125 163 h22 M129 156 l14 14 M143 156 l-14 14" /></g>
      <g class="ft-twinkle ft-t2"><path d="M268 146 v20 M258 156 h20 M262 150 l12 12 M274 150 l-12 12" /></g>
      <g class="ft-twinkle ft-t3"><path d="M196 118 v12 M190 124 h12" /></g>
    </g>
    <g class="ft-dust" fill="currentColor" opacity=".55">
      <circle cx="150" cy="196" r="2" /><circle cx="252" cy="188" r="1.8" />
      <circle cx="176" cy="150" r="1.4" /><circle cx="228" cy="164" r="1.5" />
      <circle cx="122" cy="228" r="1.6" /><circle cx="288" cy="216" r="1.7" />
      <circle cx="206" cy="96"  r="1.3" /><circle cx="164" cy="112" r="1.2" />
    </g>

    <!-- Tàn lửa bay lên -->
    <g class="ft-sparks" stroke="currentColor" stroke-width="1.2" fill="none" opacity=".75"
       stroke-linecap="round">
      <ellipse class="ft-spark ft-s1" cx="168" cy="300" rx="4"   ry="6" />
      <ellipse class="ft-spark ft-s2" cx="236" cy="284" rx="3.4" ry="5" />
      <ellipse class="ft-spark ft-s3" cx="152" cy="256" rx="3"   ry="4.4" />
      <ellipse class="ft-spark ft-s4" cx="248" cy="238" rx="3.6" ry="5.2" />
      <ellipse class="ft-spark ft-s5" cx="186" cy="226" rx="2.6" ry="4" />
    </g>

    <!-- NGỌN LỬA: lõi sáng + các lớp đường xoắn song song -->
    <g class="ft-flame">
      <ellipse cx="200" cy="368" rx="32" ry="44" fill="url(#ft-core)" />
      <g stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <!-- bao ngoài: thân phình ở dưới, vuốt cao và cong nhẹ sang phải ở đỉnh -->
        <path stroke-width="1.5" opacity=".95"
              d="M200 406 c-32 0 -48-26 -46-52 c2-30 24-48 28-78 c4-26 -6-40 -2-58
                 c4-20 18-30 24-46 c1 26 12 38 15 60 c3 22 -6 34 -2 56 c5 26 27 40 27 66
                 c0 30-20 52-44 52 Z" />
        <!-- sợi xoắn: nhiều đường gần nhau tạo texture như nét bút -->
        <path stroke-width="1.2" opacity=".85" d="M200 400 c-25 0 -38-21 -36-42 c2-25 20-40 24-66 c3-22 -5-33 -2-48 c3-17 14-25 19-40" />
        <path stroke-width="1.2" opacity=".85" d="M200 400 c25 0 38-21 36-42 c-2-25 -22-38 -25-62 c-2-20 5-30 1-46" />
        <path stroke-width="1.05" opacity=".72" d="M200 392 c-19 0 -29-17 -27-34 c2-20 16-32 19-53 c2-18 -4-27 -2-40" />
        <path stroke-width="1.05" opacity=".72" d="M200 392 c19 0 29-17 27-34 c-2-20 -17-31 -19-51 c-2-17 3-26 0-40" />
        <path stroke-width=".95" opacity=".6"  d="M200 384 c-14 0 -21-13 -20-26 c1-16 12-25 14-41 c2-14 -3-21 -1-31" />
        <path stroke-width=".95" opacity=".6"  d="M200 384 c14 0 21-13 20-26 c-1-16 -13-24 -14-40 c-1-13 2-20 0-31" />
        <path stroke-width=".85" opacity=".5"  d="M200 376 c-9 0 -14-9 -13-18 c1-11 8-17 9-27" />
        <path stroke-width=".85" opacity=".5"  d="M200 376 c9 0 14-9 13-18 c-1-11 -8-16 -9-26" />
        <path stroke-width=".8"  opacity=".42" d="M196 356 c-4 -14 2 -24 4 -36" />
        <path stroke-width=".8"  opacity=".42" d="M206 352 c3 -13 -2 -22 -4 -32" />
        <!-- giọt sáng ở chân lửa -->
        <path stroke-width="1.35" opacity=".92"
              d="M200 358 c-12 0 -19 11 -19 22 c0 14 9 24 19 24 c10 0 19-10 19-24 c0-11 -7-22 -19-22 Z" />
      </g>
    </g>

    <!-- Thân nến -->
    <g class="ft-candle" stroke="currentColor" fill="none" stroke-width="1.4"
       stroke-linecap="round" stroke-linejoin="round" opacity=".85">
      <path d="M200 404 v14" />
      <path d="M192 418 h16 v22 h-16 Z" />
      <path d="M196 424 v12 M204 424 v12" opacity=".45" stroke-width="1" />
    </g>

    <!-- Không vẽ vignette trong SVG: nó là hình chữ nhật nên luôn lộ cạnh khi
         đặt lên nền tối. Việc tối dần ra rìa để nền trang lo (radial-gradient). -->
  </svg>
</div>

<style>
  .flame-torch {
    width: var(--torch-size);
    max-width: 100%;
    aspect-ratio: 4 / 5;
    color: #efe7d8;              /* màu nét — đổi bằng `color` từ ngoài */
    line-height: 0;
  }
  .flame-torch svg { overflow: visible; }

  /* Ngọn lửa lắc nhẹ quanh chân nến, không dịch cả khối */
  .ft-flame {
    transform-origin: 200px 404px;
    animation: ft-sway 3.6s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes ft-sway {
    0%, 100% { transform: rotate(-1.4deg) scaleY(1); }
    30%      { transform: rotate(.9deg)  scaleY(1.045); }
    55%      { transform: rotate(-.5deg) scaleY(.975); }
    78%      { transform: rotate(1.6deg) scaleY(1.03); }
  }

  .ft-halo { animation: ft-breathe 4.4s ease-in-out infinite; transform-origin: 200px 270px; }
  @keyframes ft-breathe {
    0%, 100% { opacity: .82; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.06); }
  }

  /* Tàn lửa: bay lên rồi tắt. Mỗi đốm lệch pha để không thành nhịp máy móc. */
  .ft-spark { animation: ft-rise 5.2s ease-in infinite; opacity: 0; }
  .ft-s1 { animation-duration: 5.4s; animation-delay: .0s; }
  .ft-s2 { animation-duration: 6.2s; animation-delay: 1.1s; }
  .ft-s3 { animation-duration: 4.8s; animation-delay: 2.3s; }
  .ft-s4 { animation-duration: 6.8s; animation-delay: 3.1s; }
  .ft-s5 { animation-duration: 5.9s; animation-delay: 4.0s; }
  @keyframes ft-rise {
    0%   { opacity: 0;   transform: translateY(0) translateX(0) scale(.7); }
    12%  { opacity: .85; }
    60%  { opacity: .55; transform: translateY(-84px) translateX(6px) scale(1); }
    100% { opacity: 0;   transform: translateY(-170px) translateX(-8px) scale(.6); }
  }

  .ft-twinkle { animation: ft-blink 3.2s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  .ft-t1 { animation-delay: .0s; }
  .ft-t2 { animation-delay: 1.3s; animation-duration: 4.1s; }
  .ft-t3 { animation-delay: 2.2s; animation-duration: 2.8s; }
  @keyframes ft-blink {
    0%, 100% { opacity: .35; transform: scale(.9); }
    50%      { opacity: 1;   transform: scale(1.08); }
  }

  .ft-dust { animation: ft-drift 7s ease-in-out infinite; }
  @keyframes ft-drift {
    0%, 100% { opacity: .4; transform: translateY(0); }
    50%      { opacity: .75; transform: translateY(-6px); }
  }

  /* Người dùng tắt hiệu ứng chuyển động → hình vẫn đẹp, chỉ đứng yên. */
  @media (prefers-reduced-motion: reduce) {
    .ft-flame, .ft-halo, .ft-spark, .ft-twinkle, .ft-dust { animation: none; }
    .ft-spark { opacity: .5; }
  }
</style>
