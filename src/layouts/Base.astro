---
interface Props { title: string; description?: string; fullBleed?: boolean }
const { title, description = 'Seeing the Unseen — flames of knowledge in Plato\'s cave.', fullBleed = false } = Astro.props;
const q = Astro.url.searchParams.get('q') ?? '';
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · Seeing the Unseen</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
  <style is:global>
    :root {
      /* Chrome — docs/design-spec.md mục 3, trích nguyên văn từ prototype */
      --bg: #fbfaf7; --surface: #f6f3ea; --text: #3a372f; --ink: #111114;
      --muted: #8a8577; --muted-2: #9a958a; --border: #d9d4c6; --border-soft: #eee9dc;
      --flame: #f0a343; --accent: #c9563c;
      --dark-bg: #0a0910; --dark-bg-2: #141310;
      --font-pixel: 'Press Start 2P', monospace;
      --font-mono: ui-monospace, Menlo, monospace;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body { margin: 0; background: var(--bg); color: var(--text); font: 16px/1.65 system-ui, sans-serif; display: flex; flex-direction: column; min-height: 100vh; }
    a { color: var(--ink); text-decoration: none; }
    a:hover { text-decoration: underline; }
    main { flex: 1 1 auto; max-width: 880px; margin: 0 auto; padding: 2rem 1rem 4rem; width: 100%; }
    main.full-bleed { max-width: none; margin: 0; padding: 0; display: flex; overflow: hidden; }
    header.site { flex: none; display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; padding: 0 20px; height: 56px; background: var(--bg); border-bottom: 2px solid var(--ink); position: relative; z-index: 10; }
    header.site a { text-decoration: none; color: var(--text); font-family: var(--font-pixel); font-size: 9px; letter-spacing: .1em; }
    header.site a.brand { color: var(--ink); font-weight: 700; font-size: 16px; letter-spacing: -0.01em; font-family: system-ui, sans-serif; }
    .search-shell { display: flex; flex-direction: column; gap: 0.5rem; flex: 1 1 270px; min-width: 220px; max-width: 340px; }
    .search-fallback { width: 100%; }
    .search-fallback input,
    [data-pagefind-ui] input {
      width: 100%;
      height: 32px;
      padding: 0 12px;
      border: 2px solid var(--ink);
      border-radius: 7px;
      background: #fff;
      color: var(--ink);
      outline: none;
      font-size: 11px;
      letter-spacing: .08em;
    }
    .search-fallback input::placeholder,
    [data-pagefind-ui] input::placeholder {
      color: var(--muted);
    }
    [data-pagefind-ui] { width: 100%; }
    .site-nav { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
    .nav-toggle {
      display: none;
      background: none;
      border: 2px solid var(--ink);
      border-radius: 6px;
      width: 32px;
      height: 32px;
      padding: 0;
      cursor: pointer;
      align-items: center;
      justify-content: center;
      flex: none;
    }
    .nav-toggle span,
    .nav-toggle span::before,
    .nav-toggle span::after {
      content: '';
      display: block;
      width: 16px;
      height: 2px;
      background: var(--ink);
      position: relative;
    }
    .nav-toggle span::before { position: absolute; top: -5px; }
    .nav-toggle span::after { position: absolute; top: 5px; }
    @media (max-width: 640px) {
      header.site { flex-wrap: nowrap; }
      .search-shell { order: 1; }
      .nav-toggle { display: flex; order: 2; }
      header.site > div[style] { display: none; }
      .site-nav {
        display: none;
        position: absolute;
        top: 56px;
        left: 0;
        right: 0;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        background: var(--bg);
        border-bottom: 2px solid var(--ink);
        padding: 0.5rem 20px;
      }
      .site-nav.is-open { display: flex; }
      .site-nav a { padding: 0.6rem 0; border-bottom: 1px solid var(--border-soft); }
      .site-nav a:last-child { border-bottom: none; }
    }
  </style>
</head>
<body>
  <header class="site">
    <a class="brand" href="/">🔥 the unseen</a>
    <div class="search-shell" data-pagefind-ui-wrapper>
      <div data-pagefind-ui hidden></div>
      <form class="search-fallback" action="/library" method="get">
        <input name="q" type="search" placeholder="SEARCH / TÌM KIẾM ⏎" aria-label="Search" value={q} />
      </form>
    </div>
    <div style="flex:1"></div>
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false" aria-controls="siteNav">
      <span></span>
    </button>
    <nav class="site-nav" id="siteNav">
      <a href="/library/">Library</a>
      <a href="/graph/">Graph</a>
      <a href="/about/">About</a>
    </nav>
  </header>
  <main class={fullBleed ? 'full-bleed' : ''}><slot /></main>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const navToggle = document.getElementById('navToggle');
      const siteNav = document.getElementById('siteNav');
      if (navToggle && siteNav) {
        const closeNav = () => {
          siteNav.classList.remove('is-open');
          navToggle.setAttribute('aria-expanded', 'false');
        };
        navToggle.addEventListener('click', () => {
          const open = siteNav.classList.toggle('is-open');
          navToggle.setAttribute('aria-expanded', String(open));
        });
        siteNav.addEventListener('click', (event) => {
          if (event.target instanceof HTMLElement && event.target.tagName === 'A') closeNav();
        });
        document.addEventListener('click', (event) => {
          if (!siteNav.classList.contains('is-open')) return;
          if (event.target instanceof Node && (siteNav.contains(event.target) || navToggle.contains(event.target))) return;
          closeNav();
        });
      }

      const wrapper = document.querySelector('[data-pagefind-ui-wrapper]');
      if (!wrapper) return;
      const target = wrapper.querySelector('[data-pagefind-ui]');
      const fallback = wrapper.querySelector('.search-fallback');

      // Mặc định: form thường (hoạt động ngay, kể cả dev mode). Nếu Pagefind
      // (chỉ có sau `npm run build`) nạp được, thay bằng PagefindUI — không
      // bao giờ hiện thông báo lỗi/unavailable cho người dùng.
      const loadAsset = (tagName, attrs) => new Promise((resolve, reject) => {
        const el = document.createElement(tagName);
        Object.entries(attrs).forEach(([key, value]) => el.setAttribute(key, value));
        el.onload = () => resolve(el);
        el.onerror = () => reject(new Error(`Failed to load ${attrs.href || attrs.src}`));
        document.head.appendChild(el);
      });

      const showFallback = () => {
        if (target) target.hidden = true;
        if (fallback) fallback.hidden = false;
      };

      // Script tải được không có nghĩa là index dùng được: pagefind.js còn
      // phải fetch /pagefind/pagefind-entry.json trong Worker riêng. Nếu file
      // đó thiếu/hỏng (vd. binary build sai kiến trúc), PagefindUI vẫn khởi
      // tạo "thành công" nhưng search treo vĩnh viễn — nên phải tự kiểm tra
      // metadata và đặt timeout, không dựa vào onload/onerror của thẻ script.
      const metadataCheck = fetch('/pagefind/pagefind-entry.json', { cache: 'no-store' }).then((res) => {
        if (!res.ok) throw new Error(`pagefind-entry.json responded ${res.status}`);
      });
      const timeout = new Promise((_, reject) => setTimeout(() => reject(new Error('pagefind metadata timeout')), 2500));

      Promise.all([
        loadAsset('link', { rel: 'stylesheet', href: '/pagefind/pagefind-ui.css' }),
        loadAsset('script', { src: '/pagefind/pagefind-ui.js', type: 'text/javascript', async: 'false' }),
        Promise.race([metadataCheck, timeout]),
      ])
        .then(() => {
          if (typeof window.PagefindUI !== 'function') throw new Error('PagefindUI unavailable');
          new window.PagefindUI({ element: target, bundlePath: '/pagefind/' });
          if (target) target.hidden = false;
          if (fallback) fallback.hidden = true;
        })
        .catch(() => {
          // Dev mode / chưa build / index hỏng: giữ (hoặc quay lại) form thường,
          // không bao giờ để lộ spinner/lỗi Pagefind cho người dùng.
          showFallback();
        });
    });
  </script>
</body>
</html>
