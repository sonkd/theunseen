---
layout: none
permalink: /assets/decks.json
---
{% assign items = site.stuff | where_exp: "p", "p.published != false" %}
[
{% for post in items %}
  {
    "slug": {{ post.slug | default: post.title | slugify | jsonify }},
    "title": {{ post.title | jsonify }},
    "front": {{ post.front | default: post.title | jsonify }},
    "back": {{ post.back | default: post.conundrum | default: post.description | default: post.content | strip_html | strip_newlines | truncatewords: 45 | jsonify }},
    "strategy": {{ post.strategy | default: "" | jsonify }},
    "category": {{ post.categories | first | default: "Uncategorized" | jsonify }},
    "categories": {{ post.categories | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "connected": {{ post.connected | jsonify }},
    "difficulty": {{ post.difficulty | default: 2 }},
    "source": {{ post.source | default: "" | jsonify }},
    "image": {{ post.image | default: "" | jsonify }},
    "url": {{ post.url | prepend: site.baseurl | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
